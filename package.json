    "vuetify": "^4.1.5"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@tsconfig/node24": "^24.0.4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-rotate": "^0.2.0",
    "@types/node": "^26.1.1",
